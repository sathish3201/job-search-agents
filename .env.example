# Copy to .env and fill in whichever you have. Everything is optional —
# sources/agents auto-skip if their keys are missing, and you'll see which
# ones are active when you run main.py.

# --- LLM backend (dynamic: first one configured below wins, top to bottom) ---

# Your own ollama-service (FastAPI wrapper around local Ollama, OpenAI-compatible
# /v1/chat/completions, tunneled via ngrok). See C:/Users/alich/OneDrive/Desktop/
# LLM_WORK_SPACE/ollama-service/.env for the real SERVICE_API_KEY value — copy it
# here, don't regenerate. Falls back to the other backends below if unset.
OLLAMA_SERVICE_URL=https://bovine-cylinder-onboard.ngrok-free.dev
OLLAMA_SERVICE_MODEL=phi3:mini
OLLAMA_SERVICE_API_KEY=

# Fallbacks if the service above isn't reachable / not set
OLLAMA_MODEL=qwen2.5:3b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Job source connectors ---
# Adzuna: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# JSearch via RapidAPI: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Remotive has no key requirement (public API) — left here for symmetry/future auth.
REMOTIVE_ENABLED=true

# Apify (LinkedIn/Naukri/other site scraping via Apify actors) — DANGEROUS,
# see sources/apify_source.py. Scraping LinkedIn/Naukri violates their ToS;
# accounts/IPs used for this can get flagged. Both APIFY_API_KEY AND
# APIFY_ALLOW_SCRAPING=true are required — the key alone does nothing.
APIFY_API_KEY=
APIFY_ALLOW_SCRAPING=false
# Comma-separated "actor_id|label" pairs. Add more target sites/actors here
# without touching any code — e.g.:
#   APIFY_TARGETS=valig/linkedin-jobs-scraper|linkedin,muhammetakkurtt/naukri-job-scraper|naukri
APIFY_TARGETS=

# --- Candidate profile ---
RESUME_MD_PATH=./RESUME.md
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/sathish-chakali-91221b320/
NAUKRI_PROFILE_URL=https://www.naukri.com/

# --- Search preferences ---
JOB_SEARCH_QUERY=Full Stack Developer
JOB_SEARCH_LOCATION=Hyderabad, India
JOB_SEARCH_REMOTE_OK=true

# --- Automation mode (DANGEROUS - see README) ---
# Only used if you explicitly pass --mode automation at runtime.
# Leave blank until you've read and accepted the ToS/ban risk in README.md.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
